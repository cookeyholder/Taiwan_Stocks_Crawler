{
    "name": "Stock Trading Dev Environment",
    "image": "mcr.microsoft.com/devcontainers/python:3.10-bullseye",

    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    "remoteEnv": {
        "UV_INDEX_STRATEGY": "unsafe-best-match",
        "UV_LINK_MODE": "copy"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "charliermarsh.ruff",
                "GitHub.copilot",
                "ms-jupyter.jupyter",
                "ms-jupyter.vscode-jupyter-slideshow",
                "ms-jupyter.vscode-jupyter-cell-tags",
                "mhutchie.git-graph"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": false,
                "python.formatting.provider": "none",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit"
                    }
                },
                "ruff.importStrategy": "fromEnvironment",
                "ruff.lint.run": "onSave",
                "ruff.format.args": ["--line-length", "88"],
                "ruff.lint.args": ["--line-length", "88"],
                "jupyter.kernels.local.enabled": true,
                "notebook.formatOnSave.enabled": true,
                "[jupyter]": {
                    "editor.defaultFormatter": "charliermarsh.ruff"
                }
            }
        }
    },

    "postCreateCommand": "bash .devcontainer/post-create-command.sh",

    "mounts": [
        "source=${localEnv:HOME}/sqlite,target=/home/vscode/sqlite,readonly"
    ],

    "forwardPorts": [8888, 8000],

    "portsAttributes": {
        "8888": {
            "label": "Jupyter Lab",
            "onAutoForward": "notify"
        },
        "8000": {
            "label": "Development Server",
            "onAutoForward": "notify"
        }
    },

    "workspaceFolder": "/workspaces/stock-trading"
}
